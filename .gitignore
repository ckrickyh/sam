# Python 編譯暫存
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# 虛擬環境
.venv/

# AI 模型權重檔案 (嚴禁上傳大於 100MB 檔案至 GitHub)
*.pt
*.pth
*.bin
*.safetensors
*.onnx
sam3.pt

# 模型快取與本機快取目錄
.cache/
.pytest_cache/

# 輸出圖檔 (僅忽略運算產出結果，保留原始輸入資料)
data/*_segmented.png
data/*_density.png
data/output/

# macOS / 系統環境垃圾檔
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# 編輯器與環境變數檔案
.vscode/
.idea/
.env

runs/

*.log
node_modules/
*/node_modules/
*.mlpackage/

# 忽略 YOLO 訓練圖檔 (248 MB) 與訓練掃描快取
dataset/images/
dataset/labels/*.cache
*.cache
# 若想連同 data/ 原始高解析圖檔一起排除
data/*.jpg
data/*.jpeg
data/*.png
# 忽略所有模組的輸出目錄 (包含 simpleSam/output/, ultralystic/output/, samplingAnalysis/output/)
**/output/
output/
